definition {

	macro deleteABTest {
		if (isSet(testName)) {
			ACNavigation.openItem(itemName = ${testName});
		}

		Button.clickDelete();

		SelectWindow(locator1 = "name=undefined");

		Click(locator1 = "ACSettings#CONFIRMATION_BUTTON");

		Alert.viewSuccessMessage();
	}

	macro statusABTest {
		AssertTextEquals(
			locator1 = "ACTests#LABEL_STATUS",
			value1 = ${status});
	}

	macro terminateABTest {
		if (isSet(testName)) {
			ACNavigation.openItem(itemName = ${testName});
		}

		Button.click(button = "Terminate");

		SelectWindow(locator1 = "name=undefined");

		Click(locator1 = "ACSettings#CONFIRMATION_BUTTON");

		Alert.viewSuccessMessage();
	}

	macro viewABTestStatusInACList {
		AssertTextEquals(
			key_abTestTitle = ${abTestTitle},
			locator1 = "ACTests#VIEW_TEST_STATUS_ANALYTICS_CLOUD",
			value1 = ${status});
	}

		Button.click(button = "Stop Test");
	}

}